{
	"layer": "top",
	"modules-left": ["sway/workspaces"],
	// "modules-center": ["sway/window"],
	"modules-right": ["battery", "clock", ""],
	"sway/window": {
		"max-length": 50
	},
	"battery": {
		"format": "{capacity}% {icon}",
		"format-icons": ["", "", "", "", ""]
	},
	"clock": {
		"format-alt": "{:%a, %d. %b  %H:%M}"
	}
}

// volume/microphone, internet connection, brightness, battery, clock
